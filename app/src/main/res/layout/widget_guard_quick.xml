<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#FFFFFF">
    <TextView
        android:id="@+id/widget_quick_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OpenKinGuard · 快捷演练"
        android:textColor="#242424"
        android:textStyle="bold"
        android:textSize="12sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingTop="5dp">
        <TextView
            android:id="@+id/widget_quick_sos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/widget_sos_button"
            android:text="测试 SOS"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/widget_quick_checkin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/widget_safe_button"
            android:text="我已安全"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
