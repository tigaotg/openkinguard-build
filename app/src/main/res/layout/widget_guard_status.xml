<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_status_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/widget_status_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OpenKinGuard · 家人守护"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="#242424" />

    <TextView
        android:id="@+id/widget_status_online"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="● 在线状态待验证"
        android:textSize="13sp"
        android:textColor="#6851A5" />

    <TextView
        android:id="@+id/widget_status_names"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="3dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="打开应用查看谁在线"
        android:textSize="13sp"
        android:textColor="#222222" />

    <TextView
        android:id="@+id/widget_status_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="状态非实时"
        android:textSize="10sp"
        android:textColor="#555555" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_status_sos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/widget_sos_button"
            android:text="测试 SOS"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/widget_status_checkin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:background="@drawable/widget_safe_button"
            android:text="我已安全"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
