#!/bin/sh /etc/rc.common
# OpenKinGuard private family relay. Safe defaults: disabled, TLS + allowlist.

USE_PROCD=1
START=95
STOP=15

_okg_check_fingerprint() {
	case "$1" in
		*[!0123456789abcdef]*|'') return 1 ;;
	esac
	[ "${#1}" -eq 64 ]
}

_okg_count_allowed() {
	_okg_check_fingerprint "$1" && OKG_ALLOWED_COUNT=$((OKG_ALLOWED_COUNT + 1))
}

_okg_add_allowed() {
	_okg_check_fingerprint "$1" && procd_append_param command --allow "$1"
}

start_service() {
	local enabled listen port cert key max_clients rate_kbps queue_storage queue_dir
	config_load 'openkinguard-relay'
	config_get enabled main enabled '0'
	[ "$enabled" = '1' ] || return 0

	config_get listen main listen 'both'
	config_get port main port '9443'
	config_get cert main cert ''
	config_get key main key ''
	config_get max_clients main max_clients '16'
	config_get rate_kbps main rate_kbps '25000'
	config_get queue_storage main queue_storage 'tmpfs'
	case "$queue_storage" in
		tmpfs) queue_dir='/var/run/openkinguard-relay/outbox' ;;
		flash) queue_dir='/overlay/openkinguard-relay/outbox' ;;
		memory) queue_dir='' ;;
		*) logger -t okg-relay '错误：queue_storage 只能是 memory/tmpfs/flash'; return 1 ;;
	esac

	case "$listen" in both|0.0.0.0|::|127.0.0.1|::1) ;; *) logger -t okg-relay '错误：监听地址不合法'; return 1 ;; esac
	case "$port" in *[!0-9]*|'') logger -t okg-relay '错误：端口不合法'; return 1 ;; esac
	[ "$port" -ge 1024 ] && [ "$port" -le 65535 ] || { logger -t okg-relay '错误：端口需 1024..65535'; return 1; }
	case "$max_clients" in *[!0-9]*|'') logger -t okg-relay '错误：客户端数量不合法'; return 1 ;; esac
	[ "$max_clients" -ge 1 ] && [ "$max_clients" -le 64 ] || return 1
	case "$rate_kbps" in *[!0-9]*|'') logger -t okg-relay '错误：速率不合法'; return 1 ;; esac
	[ "$rate_kbps" -ge 64 ] && [ "$rate_kbps" -le 25000 ] || return 1
	[ -r "$cert" ] && [ -r "$key" ] || {
		logger -t okg-relay '错误：TLS 证书或私钥不存在/无法读取；未开启监听'
		return 1
	}
	# All unapproved devices are limited to a signed, one-time invite request.
	# State is tmpfs; private keys and approval allowlist remain separate.
	mkdir -p /var/run/openkinguard-relay
	chown nobody:nogroup /var/run/openkinguard-relay 2>/dev/null || chown nobody /var/run/openkinguard-relay
	chmod 0700 /var/run/openkinguard-relay
	touch /var/run/openkinguard-relay/state.lock
	chown nobody /var/run/openkinguard-relay/state.lock
	chmod 0600 /var/run/openkinguard-relay/state.lock
	if [ -n "$queue_dir" ]; then
		mkdir -p "$queue_dir" || return 1
		chown nobody:nogroup "$queue_dir" 2>/dev/null || chown nobody "$queue_dir"
		chmod 0700 "$queue_dir"
	fi

	procd_open_instance
	procd_set_param command /usr/bin/python3 -u /usr/lib/openkinguard-relay/relay.py \
		--listen "$listen" --port "$port" --cert "$cert" --key "$key" \
		--max-clients "$max_clients" --rate-kbps "$rate_kbps" --drop-user nobody \
		--enrollment-dir /var/run/openkinguard-relay
	[ -z "$queue_dir" ] || procd_append_param command --queue-dir "$queue_dir"
	config_list_foreach main allowed_device _okg_add_allowed
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger 'openkinguard-relay'
}
